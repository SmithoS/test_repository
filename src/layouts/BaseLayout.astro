---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Dummy Workers Lab ホーム">
        <span class="brand-mark" aria-hidden="true">D</span>
        <span>Dummy Workers Lab</span>
      </a>
      <nav aria-label="メインナビゲーション">
        <a href="/">ホーム</a>
        <a href="/about/">このサイトについて</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Cloudflare Workers へのデプロイ検証専用ダミーサイト</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    font-family:
      Inter, "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, sans-serif;
    color: #e2e8f0;
    background: #020617;
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    background: #020617;
  }

  body {
    min-height: 100vh;
    margin: 0;
    background:
      radial-gradient(circle at 15% 10%, rgb(245 158 11 / 16%), transparent 28rem),
      radial-gradient(circle at 85% 35%, rgb(56 189 248 / 12%), transparent 30rem),
      #020617;
  }

  a {
    color: inherit;
  }

  .site-header {
    width: min(1100px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .brand-mark {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 0.7rem;
    color: #111827;
    background: linear-gradient(135deg, #fbbf24, #fb923c);
    box-shadow: 0 10px 30px rgb(245 158 11 / 25%);
  }

  nav {
    display: flex;
    gap: 1.25rem;
    color: #94a3b8;
    font-size: 0.92rem;
  }

  nav a {
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible {
    color: #fbbf24;
  }

  main {
    width: min(1100px, calc(100% - 2rem));
    margin: 0 auto;
  }

  footer {
    width: min(1100px, calc(100% - 2rem));
    margin: 4rem auto 0;
    padding: 1.5rem 0 2.5rem;
    color: #64748b;
    border-top: 1px solid #1e293b;
    font-size: 0.85rem;
  }

  footer p {
    margin: 0;
  }

  @media (max-width: 620px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
